{
  "name": "dubplate-discord-music",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "A private Discord music player for your Windows desktop",
  "productName": "Dubplate",
  "author": "Ilia Zharnikov",
  "license": "MIT",
  "main": "desktop/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "node scripts/prepare-electron.js",
    "start": "electron .",
    "headless": "node src/index.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "dist": "npm run prepare:runtime && electron-builder --win nsis --x64",
    "pack": "npm run prepare:runtime && electron-builder --win --dir --x64",
    "scan:secrets": "node scripts/scan-secrets.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  }
}
